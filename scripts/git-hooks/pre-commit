#!/usr/bin/env bash
# Global pre-commit secret-scan gate — runs for every repo via the global
# core.hooksPath (~/.config/git/hooks). A repo can override with its own local
# core.hooksPath (e.g. scripts/git-hooks) to use a repo-committed scanner.
#
# Scanner preference: global ~/.config/git/secret-scan/check-secrets.sh, then
# the repo-committed scripts/check-secrets.sh, else allow the commit.
# Set SECRET_SCAN_DISABLED=1 to skip (agent rule: --no-verify only on explicit
# user instruction).
set -u
[ "${SECRET_SCAN_DISABLED:-0}" = "1" ] && exit 0
root="$(git rev-parse --show-toplevel)" || exit 0
scan="$HOME/.config/git/secret-scan/check-secrets.sh"
[ -x "$scan" ] || scan="$root/scripts/check-secrets.sh"
[ -x "$scan" ] || exit 0
exec bash "$scan" --staged
