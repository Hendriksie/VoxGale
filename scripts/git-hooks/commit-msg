#!/usr/bin/env bash
# Global commit-msg secret-scan gate — same scanner preference as pre-commit.
# Set SECRET_SCAN_DISABLED=1 to skip.
set -u
[ "${SECRET_SCAN_DISABLED:-0}" = "1" ] && exit 0
root="$(git rev-parse --show-toplevel)" || exit 0
scan="$HOME/.config/git/secret-scan/check-secrets.sh"
[ -x "$scan" ] || scan="$root/scripts/check-secrets.sh"
[ -x "$scan" ] || exit 0
exec bash "$scan" --msg "$1"
