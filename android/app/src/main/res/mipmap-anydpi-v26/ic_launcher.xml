<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (API 26+). The manifest's @mipmap/ic_launcher
     resolves here on Android 8.0 and newer: the system masks these two
     layers to the device's icon shape. Background is solid Mistral orange
     (@color/ic_launcher_background = #FF7000); the foreground is the white
     waveform glyph, same proportions as the legacy density PNGs. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
