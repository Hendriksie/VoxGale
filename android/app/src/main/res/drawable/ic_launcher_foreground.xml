<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon foreground (API 26+): the white speech-bubble glyph on the
     108dp adaptive-icon canvas. The glyph is a rounded speech bubble with a
     bottom-left tail; the four waveform bars inside it are cut out of the
     bubble (fillType="evenOdd"), so the orange <background> layer
     (@color/ic_launcher_background) shows through as the bars — identical
     to the legacy mipmap-*/ic_launcher.png raster, which paints the bars in
     the same orange. Geometry (108dp canvas, glyph inside the 66dp safe
     zone, i.e. within 21..87 on both axes):
       - bubble: rounded rect x=22 y=28 w=64 h=38, corner radius 9
       - tail:   triangle (34,64) (30,80) (48,64), merging into the
                 bubble's bottom edge
       - bars:   four capsules, width 5.5 (radius 2.75), at x=37/46.5/56/
                 65.5, heights 10/18/24/14, centred on the bubble's midline
                 y=47
     The orange background comes from the <background> layer, so this
     drawable is white-only. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M 31,28
            L 77,28
            A 9,9 0 0 1 86,37
            L 86,57
            A 9,9 0 0 1 77,66
            L 31,66
            A 9,9 0 0 1 22,57
            L 22,37
